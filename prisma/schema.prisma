generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String   @id @default(cuid())
  username             String   @unique
  email                String   @unique
  passwordHash         String?
  googleId             String?  @unique
  appleId              String?  @unique
  avatarUrl            String?
  allowedRoles         String[] @default([])
  magicPreferencesJson String?
  role                 String   @default("collector")
  mustChangePassword   Boolean  @default(false)
  hasSeenTour          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  userPreferences UserPreference?
  shop            Shop?

  @@map("users")
}

model CollectionUpload {
  id             String   @id @default(cuid())
  userId         String
  rawText        String
  detectedFormat String?
  parsedData     String?
  createdAt      DateTime @default(now())

  @@map("collection_uploads")
}

model InventoryItem {
  id              String   @id @default(cuid())
  userId          String
  name            String
  itemType        String
  collectionType  String?
  scryfallId      String?
  setCode         String?
  collectorNumber String?
  finish          String?
  statusLocation  String   @default("storage")
  brandSet        String?
  estimatedValue  Float?
  primaryImageUrl String?
  isBase          Boolean  @default(false)
  isParallel      Boolean  @default(false)
  isAutograph     Boolean  @default(false)
  isRookie        Boolean  @default(false)
  gradingCompany  String?
  gradeScore      Float?
  productLine     String?
  packaging       String?
  quantity        Int      @default(1)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deckItems DeckItem[]

  @@map("inventory_items")
}

model Deck {
  id             String    @id @default(cuid())
  userId         String
  name           String
  format         String?
  strategy       String?
  commander      String?
  cards          String?
  deckType       String    @default("paper")
  personaType    String?
  coreGoal       String?
  lastAnalyzed   DateTime?
  gamesPlayed    Int       @default(0)
  gamesWon       Int       @default(0)
  lastPlayedDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items       DeckItem[]
  analyses    DeckAnalysis[]
  suggestions Suggestion[]

  @@map("decks")
}

model DeckItem {
  id     String        @id @default(cuid())
  deckId String
  deck   Deck          @relation(fields: [deckId], references: [id], onDelete: Cascade)
  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([deckId, itemId])
  @@map("deck_items")
}

model UserLocationPreference {
  id      String   @id @default(cuid())
  userId  String   @unique
  address String
  savedAt DateTime @default(now()) @updatedAt

  @@map("user_location_preferences")
}

model CardPrice {
  id           String   @id @default(cuid())
  cardName     String
  cardSetCode  String?
  priceUsd     Float?
  priceFoilUsd Float?
  priceEur     Float?
  source       String   @default("scryfall")
  lastUpdated  DateTime @default(now())

  @@unique([cardName, cardSetCode, source])
  @@index([cardName])
  @@index([lastUpdated])
  @@map("card_prices")
}

model PriceHistory {
  id           String   @id @default(cuid())
  cardName     String
  cardSetCode  String?
  source       String   @default("scryfall")
  priceUsd     Float?
  priceFoilUsd Float?
  capturedAt   DateTime @default(now())

  @@unique([cardName, source, capturedAt])
  @@index([cardName, capturedAt])
  @@map("price_history")
}

model CollectionStats {
  id              String   @id @default(cuid())
  userId          String   @unique
  totalValueUsd   Float    @default(0)
  valueChange7d   Float?
  uniqueCardCount Int      @default(0)
  totalCardCount  Int      @default(0)
  duplicateCount  Int      @default(0)
  lastUpdated     DateTime @default(now()) @updatedAt

  @@map("collection_stats")
}

model PriceAlert {
  id            String    @id @default(cuid())
  userId        String
  cardName      String
  alertType     String
  previousPrice Float
  currentPrice  Float
  changePercent Float
  triggered     Boolean   @default(false)
  triggeredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@map("price_alerts")
}

model KhoaChat {
  id        String  @id
  userId    String
  title     String
  messages  String  @default("[]")
  pinned    Boolean @default(false)
  createdAt String
  updatedAt String

  @@index([userId])
  @@map("khoa_chats")
}

model DeckAnalysis {
  id                 String    @id @default(cuid())
  userId             String
  deckId             String
  deck               Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  analyzedAt         DateTime  @default(now())
  avgManaCost        Float?
  colorIdentity      String?
  creatureCount      Int?
  spellCount         Int?
  landCount          Int?
  synergiesDetected  String?
  metaScore          Float?
  tourneyAppearances Int?
  successRate        Float?
  playedDate         DateTime?
  notes              String?

  @@index([userId, analyzedAt(sort: Desc)])
  @@map("deck_analysis")
}

model CardCategory {
  id                     String   @id @default(cuid())
  cardName               String   @unique
  categories             String[]
  classificationMethod   String   @default("rules")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([cardName])
  @@map("card_categories")
}

model CardSynergy {
  id             String  @id @default(cuid())
  cardName       String
  synergyPartner String
  synergyType    String
  strength       Float
  note           String?

  @@unique([cardName, synergyPartner])
  @@index([cardName])
  @@index([synergyPartner])
  @@map("card_synergies")
}

model UserPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteFormats       String?
  playStyle             String?
  budgetRange           String?
  collectorOrPlayer     String?
  acceptanceRate        Float?
  averageDeckTurnaround String?
  colorPreferences      String?
  updatedAt             DateTime @updatedAt

  @@map("user_preferences")
}

model Suggestion {
  id             String    @id @default(cuid())
  userId         String
  deckId         String?
  deck           Deck?     @relation(fields: [deckId], references: [id], onDelete: SetNull)
  cardName       String?
  suggestionType String
  reason         String?
  suggestedAt    DateTime  @default(now())
  adopted        Boolean?
  adoptedAt      DateTime?
  userFeedback   String?

  @@index([userId, suggestedAt(sort: Desc)])
  @@index([userId, adopted])
  @@map("suggestions")
}

model BannedListSnapshot {
  id              String   @id @default(cuid())
  format          String
  bannedCards     String?
  restrictedCards String?
  snapshotDate    DateTime @default(now())

  @@unique([format, snapshotDate])
  @@index([format, snapshotDate(sort: Desc)])
  @@map("banned_list_snapshots")
}

model CommunityVenue {
  id          String    @id
  name        String
  address     String?
  city        String?
  state       String?
  zipCode     String?
  latitude    Float?
  longitude   Float?
  formats     String?
  eventTypes  String?
  website     String?
  phone       String?
  verifiedAt  DateTime?
  userRating  Float?
  reviewCount Int?
  createdAt   DateTime  @default(now())

  @@index([city, state])
  @@map("community_venues")
}

model Shop {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  slug            String   @unique
  description     String?
  address         String?
  city            String?
  state           String?
  zip             String?
  lat             Decimal? @db.Decimal(9, 6)
  lng             Decimal? @db.Decimal(9, 6)
  phone           String?
  email           String?
  websiteUrl      String?
  customDomain    String?
  logoUrl         String?
  bannerUrl       String?
  stripeAccountId  String?
  isActive         Boolean  @default(true)
  conditionMatrix  Json?    @default("{\"NM\":100,\"LP\":85,\"MP\":70,\"HP\":50,\"DMG\":25}") @map("condition_matrix")
  floorPrices      Json?    @default("{\"global\":10,\"C\":10,\"U\":25,\"R\":50,\"M\":100}") @map("floor_prices")
  buyMatrix        Json?    @default("{\"NM\":60,\"LP\":51,\"MP\":42,\"HP\":30,\"DMG\":15}") @map("buy_matrix")
  marginTargets    Json?    @default("{\"under_1\":60,\"1_to_10\":45,\"10_to_50\":40,\"over_50\":35}") @map("margin_targets")
  // Marketplace fields
  marketplaceActive Boolean  @default(true) @map("marketplace_active")
  hours             Json?
  specialties       String[] @default([])
  holdInstructions  String?  @map("hold_instructions")
  featuredUntil     DateTime? @map("featured_until")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inventory          ShopInventory[]
  orders             ShopOrder[]
  pricingRules       ShopPricingRule[]
  buyRules           ShopBuyRule[]
  purchases          ShopPurchase[]
  offers             ShopOffer[]
  holds              Hold[]
  holdGroups         HoldGroup[]
  notificationPrefs  ShopNotificationPrefs?
  shopCampaigns      ShopCampaign[]

  @@map("shops")
}

model ShopInventory {
  id              String   @id @default(cuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  scryfallId      String
  cardName        String
  setCode         String
  collectorNumber String?
  condition       String
  foil            Boolean  @default(false)
  language        String   @default("en")
  quantity        Int      @default(1)
  priceCents      Int
  notes           String?
  imageUrl        String?
  typeLine        String?
  colors          String?  // JSON array e.g. ["W","U"]
  cmc             Float?
  rarity          String?
  priceUpdatedAt  DateTime? @map("price_updated_at")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems ShopOrderItem[]

  @@index([shopId])
  @@index([scryfallId])
  @@index([cardName])
  @@map("shop_inventory")
}

model ShopOrder {
  id                    String   @id @default(cuid())
  shopId                String
  shop                  Shop     @relation(fields: [shopId], references: [id])
  buyerUserId           String
  stripePaymentIntentId String?
  status                String   @default("pending")
  subtotalCents         Int
  platformFeeCents      Int
  totalCents            Int
  fulfillmentType       String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  items ShopOrderItem[]

  @@index([shopId])
  @@index([buyerUserId])
  @@map("shop_orders")
}

model ShopOrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       ShopOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryId String?
  inventory   ShopInventory? @relation(fields: [inventoryId], references: [id])
  cardName    String
  quantity    Int
  priceCents  Int

  @@map("shop_order_items")
}

model ShopPricingRule {
  id                 String   @id @default(cuid())
  shopId             String   @map("shop_id")
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  priority           Int
  scopeConditions    String[] @default([]) @map("scope_conditions")
  scopeRarities      String[] @default([]) @map("scope_rarities")
  scopeSetCodes      String[] @default([]) @map("scope_set_codes")
  scopePriceMinCents Int?     @map("scope_price_min_cents")
  scopePriceMaxCents Int?     @map("scope_price_max_cents")
  strategy           String
  strategyValue      Decimal? @db.Decimal(8, 2) @map("strategy_value")
  strategyDirection  String?  @map("strategy_direction")
  floorPriceCents    Int?     @map("floor_price_cents")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([shopId, priority])
  @@map("shop_pricing_rules")
}

model ShopBuyRule {
  id                   String   @id @default(cuid())
  shopId               String   @map("shop_id")
  shop                 Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  priority             Int
  scopeConditions      String[] @default([]) @map("scope_conditions")
  scopeRarities        String[] @default([]) @map("scope_rarities")
  scopeSetCodes        String[] @default([]) @map("scope_set_codes")
  scopePriceMinCents   Int?     @map("scope_price_min_cents")
  scopePriceMaxCents   Int?     @map("scope_price_max_cents")
  scopeTrendThresholdPct Decimal? @db.Decimal(5, 2) @map("scope_trend_threshold_pct")
  adjustmentType       String   @map("adjustment_type")
  adjustmentValue      Decimal  @db.Decimal(8, 2) @map("adjustment_value")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([shopId, priority])
  @@map("shop_buy_rules")
}

model ShopPurchase {
  id             String         @id @default(cuid())
  shopId         String         @map("shop_id")
  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sellerName     String?        @map("seller_name")
  sellerContact  String?        @map("seller_contact")
  totalPaidCents Int            @map("total_paid_cents")
  notes          String?
  status         String         @default("completed")
  createdAt      DateTime       @default(now()) @map("created_at")

  items          ShopPurchaseItem[]

  @@index([shopId])
  @@map("shop_purchases")
}

model ShopPurchaseItem {
  id                  String       @id @default(cuid())
  purchaseId          String       @map("purchase_id")
  purchase            ShopPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  scryfallId          String       @map("scryfall_id")
  cardName            String       @map("card_name")
  setCode             String       @default("") @map("set_code")
  condition           String
  foil                Boolean      @default(false)
  quantity            Int
  buyPriceCents       Int          @map("buy_price_cents")
  tcgMarketCents      Int          @map("tcg_market_cents")
  targetSellPriceCents Int?        @map("target_sell_price_cents")

  @@map("shop_purchase_items")
}

model ShopOffer {
  id               String   @id @default(cuid())
  shopId           String   @map("shop_id")
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items            Json
  totalCents       Int      @map("total_cents")
  roundedTotalCents Int     @map("rounded_total_cents")
  shopName         String   @map("shop_name")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("shop_offers")
}

// ─── Local Marketplace ────────────────────────────────────────────────────────

model HoldGroup {
  id              String   @id @default(cuid())
  collectorUserId String?  @map("collector_user_id")
  guestEmail      String?  @map("guest_email")
  guestToken      String?  @unique @map("guest_token")
  shopId          String   @map("shop_id")
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sourceDeckId    String?  @map("source_deck_id")
  sourceListId    String?  @map("source_list_id")
  collectorNote   String?  @map("collector_note")
  pickupWindow    String?  @map("pickup_window")
  createdAt       DateTime @default(now()) @map("created_at")

  holds Hold[]

  @@index([collectorUserId])
  @@index([shopId])
  @@map("hold_groups")
}

model Hold {
  id              String   @id @default(cuid())
  collectorUserId String?  @map("collector_user_id")
  guestName       String?  @map("guest_name")
  guestEmail      String?  @map("guest_email")
  guestToken      String?  @unique @map("guest_token")
  shopId          String   @map("shop_id")
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  inventoryItemId String?  @map("inventory_item_id")
  holdGroupId     String?  @map("hold_group_id")
  holdGroup       HoldGroup? @relation(fields: [holdGroupId], references: [id], onDelete: SetNull)

  // Card snapshot at request time
  cardName        String   @map("card_name")
  scryfallId      String   @map("scryfall_id")
  setCode         String   @map("set_code")
  collectorNumber String?  @map("collector_number")
  condition       String
  foil            Boolean  @default(false)
  priceCents      Int      @map("price_cents")

  // Status: requested | confirmed | completed | declined | expired | cancelled
  status          String   @default("requested")

  // Collector input
  collectorNote   String?  @map("collector_note")
  pickupWindow    String?  @map("pickup_window")

  // Shop response
  shopNote        String?  @map("shop_note")
  confirmedAt     DateTime? @map("confirmed_at")
  declinedAt      DateTime? @map("declined_at")
  completedAt     DateTime? @map("completed_at")
  cancelledAt     DateTime? @map("cancelled_at")

  // Expiry
  requestExpiresAt DateTime @map("request_expires_at")
  pickupExpiresAt  DateTime? @map("pickup_expires_at")

  // Notification tracking
  shopNotifiedSmsAt  DateTime? @map("shop_notified_sms_at")
  shopNotifiedAppAt  DateTime? @map("shop_notified_app_at")
  collectorNotifiedAt DateTime? @map("collector_notified_at")

  // Source attribution
  sourceDeckId     String? @map("source_deck_id")
  sourceListId     String? @map("source_list_id")
  sourceCampaignId String? @map("source_campaign_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([collectorUserId])
  @@index([shopId])
  @@index([status])
  @@index([inventoryItemId])
  @@index([holdGroupId])
  @@index([sourceCampaignId])
  @@map("holds")
}

model ShopNotificationPrefs {
  id                  String   @id @default(cuid())
  shopId              String   @unique @map("shop_id")
  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  smsEnabled          Boolean  @default(true) @map("sms_enabled")
  smsNumber           String?  @map("sms_number")
  emailEnabled        Boolean  @default(true) @map("email_enabled")
  appEnabled          Boolean  @default(true) @map("app_enabled")
  requestExpiryHours  Int      @default(24) @map("request_expiry_hours")
  pickupExpiryHours   Int      @default(72) @map("pickup_expiry_hours")
  maxActiveHolds      Int      @default(50) @map("max_active_holds")
  campaignsPerWeek    Int      @default(3) @map("campaigns_per_week")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("shop_notification_prefs")
}

model CollectorNotificationPrefs {
  id                     String   @id @default(cuid())
  userId                 String   @unique @map("user_id")
  availabilityAlerts     Boolean  @default(true) @map("availability_alerts")
  campaignNotifications  Boolean  @default(true) @map("campaign_notifications")
  holdNotifications      Boolean  @default(true) @map("hold_notifications")
  searchRadiusMiles      Int      @default(50) @map("search_radius_miles")
  optedOutShops          String[] @default([]) @map("opted_out_shops")
  // Location (set via settings page — GPS or zip)
  lat                    Decimal? @db.Decimal(9, 6)
  lng                    Decimal? @db.Decimal(9, 6)
  locationUpdatedAt      DateTime? @map("location_updated_at")
  // SMS for collectors
  smsEnabled             Boolean  @default(false) @map("sms_enabled")
  smsNumber              String?  @map("sms_number")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("collector_notification_prefs")
}

model CollectorCardWatchlist {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  scryfallId          String   @map("scryfall_id")
  cardName            String   @map("card_name")
  // deck_missing | wishlist | manual
  sourceType          String   @map("source_type")
  sourceId            String?  @map("source_id")
  maxPriceCents       Int?     @map("max_price_cents")
  conditionFloor      String   @default("HP") @map("condition_floor")
  lastNotifiedAt      DateTime? @map("last_notified_at")
  notifyCooldownHours Int      @default(24) @map("notify_cooldown_hours")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([userId, scryfallId, sourceType, sourceId])
  @@index([scryfallId])
  @@index([userId])
  @@map("collector_card_watchlist")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  // hold_requested | hold_confirmed | hold_declined | hold_expired |
  // hold_completed | hold_cancelled |
  // card_available | card_available_batch |
  // campaign_new_inventory | campaign_sale | campaign_buylist | campaign_featured | campaign_event
  type        String
  title       String
  body        String
  holdId      String?  @map("hold_id")
  campaignId  String?  @map("campaign_id")
  scryfallId  String?  @map("scryfall_id")
  shopId      String?  @map("shop_id")
  ctaUrl      String?  @map("cta_url")
  read        Boolean  @default(false)
  readAt      DateTime? @map("read_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([holdId])
  @@map("notifications")
}

model ShopCampaign {
  id              String   @id @default(cuid())
  shopId          String   @map("shop_id")
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // new_inventory | sale | buylist | featured_card | event
  type            String
  title           String
  body            String
  ctaText         String?  @map("cta_text")
  ctaUrl          String?  @map("cta_url")

  // Targeting: matching_watchlist | radius | all
  targetType      String   @default("matching_watchlist") @map("target_type")
  radiusMiles     Int      @default(50) @map("radius_miles")
  scryfallIds     String[] @default([]) @map("scryfall_ids")
  discountPercent Int?     @map("discount_percent")
  validUntil      DateTime? @map("valid_until")

  // Delivery
  // draft | scheduled | sent | cancelled
  status          String   @default("draft")
  scheduledFor    DateTime? @map("scheduled_for")
  sentAt          DateTime? @map("sent_at")
  recipientsCount Int?     @map("recipients_count")

  // Rate limit tracking (ISO week)
  weekNumber      Int?     @map("week_number")
  weekYear        Int?     @map("week_year")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveries CampaignDelivery[]

  @@index([shopId])
  @@index([status])
  @@index([shopId, weekNumber, weekYear])
  @@map("shop_campaigns")
}

model CampaignDelivery {
  id          String   @id @default(cuid())
  campaignId  String   @map("campaign_id")
  campaign    ShopCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  deliveredAt DateTime @default(now()) @map("delivered_at")
  read        Boolean  @default(false)
  readAt      DateTime? @map("read_at")
  clicked     Boolean  @default(false)
  clickedAt   DateTime? @map("clicked_at")

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@map("campaign_deliveries")
}

// Also add back-relations to User (virtual — no new columns needed)
// User.holds, User.notifications, User.collectorNotificationPrefs, User.collectorCardWatchlist
// are accessed via raw SQL queries using userId — Prisma relations not added to avoid schema migration conflicts

// ── Speculation Market ──────────────────────────────────────────────────────
// One row per printing per day. Keyed by scryfallId (not card name) so
// different printings of the same card are tracked separately — a card
// name alone is ambiguous across sets/printings.
model MarketPriceSnapshot {
  id         String   @id @default(cuid())
  scryfallId String   @map("scryfall_id")
  cardName   String   @map("card_name")
  setCode    String   @map("set_code")
  priceDate  DateTime @map("price_date") @db.Date
  usd        Float?
  usdFoil    Float?   @map("usd_foil")
  // Captured for free from the same daily-sync bulk file — enables signal
  // computation (comparable-card grouping) without an extra data source.
  rarity     String?
  cmc        Float?
  capturedAt DateTime @default(now()) @map("captured_at")

  @@unique([scryfallId, priceDate])
  @@index([scryfallId, priceDate])
  @@index([setCode, priceDate])
  // Powers getPrintings() — grouping every tracked printing of a card
  // (e.g. Sol Ring has 100+) by name. Without this, that lookup is a
  // sequential scan over the whole table (1M+ rows, ~9s — routinely
  // hitting queryWithTimeout's 8s budget and silently returning empty).
  @@index([cardName])
  @@map("market_price_snapshots")
}

// Set-level release dates, refreshed daily from Scryfall's /sets endpoint.
// Used to derive a card's "release phase" signal — simpler than tracking a
// true per-printing first-release date, and close enough in practice since
// a card's price behavior around release is really about its set's release.
model MarketSetReleaseDate {
  setCode    String   @id @map("set_code")
  releasedAt DateTime? @map("released_at") @db.Date
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("market_set_release_dates")
}

// One row per printing per day — momentum, volatility, release-cycle phase,
// and relative-value signals, computed daily by the cron sync job (never
// live on a page request — see lib/signal-calculator.ts).
model MarketSignal {
  id                 String   @id @default(cuid())
  scryfallId         String   @map("scryfall_id")
  date               DateTime @map("date") @db.Date
  setCode            String   @map("set_code")
  rarity             String?
  cmc                Float?

  daysSinceRelease   Int?     @map("days_since_release")
  releasePhase       String?  @map("release_phase")

  momentum7d         Float?   @map("momentum_7d")
  momentum30d        Float?   @map("momentum_30d")
  momentum90d        Float?   @map("momentum_90d")
  volatility7d       Float?   @map("volatility_7d")
  volatility30d      Float?   @map("volatility_30d")

  priceVsSetMedian   Float?   @map("price_vs_set_median")

  currentPrice       Float?   @map("current_price")
  price52wHigh       Float?   @map("price_52w_high")
  price52wLow        Float?   @map("price_52w_low")

  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([scryfallId, date])
  @@index([scryfallId, date])
  @@index([date, momentum7d])
  @@map("market_signals")
}

// The pattern library — mostly a documentation/transparency table. The
// actual pattern-matching logic is a hardcoded SQL CASE in
// lib/prediction-engine.ts (dynamic JSON-condition interpretation was
// deliberately skipped as unneeded complexity for a handful of patterns).
model MarketPattern {
  id                 String   @id @default(cuid())
  patternName        String   @unique @map("pattern_name")
  description        String
  predictedPctChange Float    @map("predicted_pct_change")
  confidencePct      Float    @map("confidence_pct")
  priority           Int
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("market_patterns")
}

// One row per printing per day — a heuristic 6-month price call, matched
// against market_signals by lib/prediction-engine.ts. Confidence reflects
// pattern-match strength, NOT backtested accuracy — no prediction has had
// 6 months to resolve yet, so there is no real accuracy data to report.
model MarketPrediction {
  id               String   @id @default(cuid())
  scryfallId       String   @map("scryfall_id")
  date             DateTime @map("date") @db.Date

  // Denormalized from market_signals/market_price_snapshots at write-time —
  // the Speculation Scoreboard lists/sorts/filters across all 85k+ rows and
  // a live join to look these up on every page load was ~6s (too slow for
  // a page render); writing them once here, during the daily cron's
  // predictions pass, makes the scoreboard query a single-table scan.
  cardName         String?  @map("card_name")
  setCode          String?  @map("set_code")

  currentPrice     Float?   @map("current_price")
  targetPrice6m    Float?   @map("target_price_6m")
  targetPrice6mLow Float?   @map("target_price_6m_low")
  targetPrice6mHigh Float?  @map("target_price_6m_high")
  confidencePct    Float?   @map("confidence_pct")
  // 'bullish' | 'neutral' | 'bearish'
  predictionDirection String? @map("prediction_direction")
  matchedPattern   String?  @map("matched_pattern")
  dominantSignals  Json?    @map("dominant_signals")

  upsideScenario   String?  @map("upside_scenario")
  upsideTarget     Float?   @map("upside_target")
  downsideScenario String?  @map("downside_scenario")
  downsideTarget   Float?   @map("downside_target")
  riskFactors      Json?    @map("risk_factors")

  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([scryfallId, date])
  @@index([scryfallId, date])
  // Powers the Speculation Scoreboard: "latest date, filter by direction,
  // sort by confidence" without touching any other table.
  @@index([date, predictionDirection, confidencePct])
  @@map("market_predictions")
}

// Real, cited "why" context for a card — Tavily search restricted to
// trusted MTG sources, extracted into a short summary by Gemini. Same
// pattern as format_legality_cache (ban-list lookup), scoped to a small
// daily candidate set (watchlist + top movers), not all tracked printings —
// see lib/card-news.ts.
model MarketCardNews {
  scryfallId String   @id @map("scryfall_id")
  cardName   String   @map("card_name")
  hasNews    Boolean  @default(false) @map("has_news")
  summary    String?
  // 'reprint' | 'banned' | 'tournament' | 'set_synergy' | 'other' | null
  category   String?
  sourceUrls String[] @map("source_urls")
  confidence Float?
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@map("market_card_news")
}

// Append-only event history — market_card_news above is a single-row cache
// of "what to show right now"; this is the durable log that lets us later
// ask "what happened right before this card's price moved" and eventually
// backtest event-driven predictions instead of relying on general MTG
// market knowledge. One row per *newly detected* event (see
// upsertCardNews() in lib/card-news.ts for the dedup logic that keeps a
// week of identical cache refreshes from creating duplicate rows) —
// priceAtDetection is captured so a future job can compute "price N days
// after this event" without re-deriving it from raw snapshots.
model MarketCardEvent {
  id              String   @id @default(cuid())
  scryfallId      String   @map("scryfall_id")
  cardName        String   @map("card_name")
  // 'reprint' | 'banned' | 'tournament' | 'set_synergy' | 'other'
  category        String
  summary         String
  sourceUrls      String[] @map("source_urls")
  confidence      Float?
  priceAtDetection Float?  @map("price_at_detection")
  detectedAt      DateTime @default(now()) @map("detected_at")

  @@index([scryfallId, detectedAt])
  @@index([detectedAt])
  @@map("market_card_events")
}

// Precomputed gainers/losers, refreshed once daily by the cron sync job
// instead of running the (expensive, whole-table self-join) aggregate live
// on every page load. cacheKey is e.g. "set:7" or "card:30".
model MarketMoversCache {
  id         String   @id @default(cuid())
  cacheKey   String   @unique @map("cache_key")
  payload    Json
  computedAt DateTime @default(now()) @map("computed_at")

  @@map("market_movers_cache")
}

model MarketWatchlistItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  // 'card' | 'set'
  kind      String
  scryfallId String? @map("scryfall_id")
  cardName  String?  @map("card_name")
  setCode   String?  @map("set_code")
  setName   String?  @map("set_name")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, kind, scryfallId, setCode])
  @@index([userId])
  @@map("market_watchlist_items")
}
