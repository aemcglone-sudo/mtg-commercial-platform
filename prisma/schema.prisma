generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String   @id @default(cuid())
  username             String   @unique
  email                String   @unique
  passwordHash         String?
  googleId             String?  @unique
  appleId              String?  @unique
  avatarUrl            String?
  magicPreferencesJson String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  userPreferences UserPreference?

  @@map("users")
}

model CollectionUpload {
  id             String   @id @default(cuid())
  userId         String
  rawText        String
  detectedFormat String?
  parsedData     String?
  createdAt      DateTime @default(now())

  @@map("collection_uploads")
}

model InventoryItem {
  id              String   @id @default(cuid())
  userId          String
  name            String
  itemType        String
  collectionType  String?
  statusLocation  String   @default("storage")
  brandSet        String?
  estimatedValue  Float?
  primaryImageUrl String?
  isBase          Boolean  @default(false)
  isParallel      Boolean  @default(false)
  isAutograph     Boolean  @default(false)
  isRookie        Boolean  @default(false)
  gradingCompany  String?
  gradeScore      Float?
  productLine     String?
  packaging       String?
  quantity        Int      @default(1)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deckItems DeckItem[]

  @@map("inventory_items")
}

model Deck {
  id             String    @id @default(cuid())
  userId         String
  name           String
  format         String?
  strategy       String?
  cards          String?
  deckType       String    @default("paper")
  personaType    String?
  coreGoal       String?
  lastAnalyzed   DateTime?
  gamesPlayed    Int       @default(0)
  gamesWon       Int       @default(0)
  lastPlayedDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items       DeckItem[]
  analyses    DeckAnalysis[]
  suggestions Suggestion[]

  @@map("decks")
}

model DeckItem {
  id     String        @id @default(cuid())
  deckId String
  deck   Deck          @relation(fields: [deckId], references: [id], onDelete: Cascade)
  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([deckId, itemId])
  @@map("deck_items")
}

model UserLocationPreference {
  id      String   @id @default(cuid())
  userId  String   @unique
  address String
  savedAt DateTime @default(now()) @updatedAt

  @@map("user_location_preferences")
}

model CardPrice {
  id           String   @id @default(cuid())
  cardName     String
  cardSetCode  String?
  priceUsd     Float?
  priceFoilUsd Float?
  priceEur     Float?
  source       String   @default("scryfall")
  lastUpdated  DateTime @default(now())

  @@unique([cardName, cardSetCode, source])
  @@index([cardName])
  @@index([lastUpdated])
  @@map("card_prices")
}

model PriceHistory {
  id           String   @id @default(cuid())
  cardName     String
  cardSetCode  String?
  source       String   @default("scryfall")
  priceUsd     Float?
  priceFoilUsd Float?
  capturedAt   DateTime @default(now())

  @@unique([cardName, source, capturedAt])
  @@index([cardName, capturedAt])
  @@map("price_history")
}

model CollectionStats {
  id              String   @id @default(cuid())
  userId          String   @unique
  totalValueUsd   Float    @default(0)
  valueChange7d   Float?
  uniqueCardCount Int      @default(0)
  totalCardCount  Int      @default(0)
  duplicateCount  Int      @default(0)
  lastUpdated     DateTime @default(now()) @updatedAt

  @@map("collection_stats")
}

model PriceAlert {
  id            String    @id @default(cuid())
  userId        String
  cardName      String
  alertType     String
  previousPrice Float
  currentPrice  Float
  changePercent Float
  triggered     Boolean   @default(false)
  triggeredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@map("price_alerts")
}

model KhoaChat {
  id        String @id
  userId    String
  title     String
  messages  String @default("[]")
  createdAt String
  updatedAt String

  @@index([userId])
  @@map("khoa_chats")
}

model DeckAnalysis {
  id                 String    @id @default(cuid())
  userId             String
  deckId             String
  deck               Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  analyzedAt         DateTime  @default(now())
  avgManaCost        Float?
  colorIdentity      String?
  creatureCount      Int?
  spellCount         Int?
  landCount          Int?
  synergiesDetected  String?
  metaScore          Float?
  tourneyAppearances Int?
  successRate        Float?
  playedDate         DateTime?
  notes              String?

  @@index([userId, analyzedAt(sort: Desc)])
  @@map("deck_analysis")
}

model CardSynergy {
  id             String  @id @default(cuid())
  cardName       String
  synergyPartner String
  synergyType    String
  strength       Float
  note           String?

  @@unique([cardName, synergyPartner])
  @@index([cardName])
  @@index([synergyPartner])
  @@map("card_synergies")
}

model UserPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteFormats       String?
  playStyle             String?
  budgetRange           String?
  collectorOrPlayer     String?
  acceptanceRate        Float?
  averageDeckTurnaround String?
  colorPreferences      String?
  updatedAt             DateTime @updatedAt

  @@map("user_preferences")
}

model Suggestion {
  id             String    @id @default(cuid())
  userId         String
  deckId         String?
  deck           Deck?     @relation(fields: [deckId], references: [id], onDelete: SetNull)
  cardName       String?
  suggestionType String
  reason         String?
  suggestedAt    DateTime  @default(now())
  adopted        Boolean?
  adoptedAt      DateTime?
  userFeedback   String?

  @@index([userId, suggestedAt(sort: Desc)])
  @@index([userId, adopted])
  @@map("suggestions")
}

model BannedListSnapshot {
  id              String   @id @default(cuid())
  format          String
  bannedCards     String?
  restrictedCards String?
  snapshotDate    DateTime @default(now())

  @@unique([format, snapshotDate])
  @@index([format, snapshotDate(sort: Desc)])
  @@map("banned_list_snapshots")
}

model CommunityVenue {
  id          String    @id
  name        String
  address     String?
  city        String?
  state       String?
  zipCode     String?
  latitude    Float?
  longitude   Float?
  formats     String?
  eventTypes  String?
  website     String?
  phone       String?
  verifiedAt  DateTime?
  userRating  Float?
  reviewCount Int?
  createdAt   DateTime  @default(now())

  @@index([city, state])
  @@map("community_venues")
}
